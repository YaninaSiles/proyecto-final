{
  "datasets": [
    {
      "name": "a6016e61",
      "displayName": "Geospatial Classification of Entities and Neighborhoods",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "    f.latitud,\r\n",
        "    f.longitud,\r\n",
        "    c.tipo_entidad,\r\n",
        "    c.subcategoria,\r\n",
        "    e.nombre_entidad,\r\n",
        "    f.es_generador_trafico,\r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    com.nro_comuna,\r\n",
        "    CASE \r\n",
        "        WHEN f.es_competencia = 1 THEN 'Competencia (Kioscos)'\r\n",
        "        WHEN f.es_generador_trafico = 1 THEN 'Atracción (Escuelas/Hosp/Univ)'\r\n",
        "        ELSE 'Otro' \r\n",
        "    END AS clasificacion_mapa\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "JOIN proyecto_final.gold.dim_categoria c ON f.categoria_id = c.id\r\n",
        "JOIN proyecto_final.gold.dim_entidad e ON f.entidad_id = e.id\r\n",
        "JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "JOIN proyecto_final.gold.dim_comunas com ON f.comuna_id = com.id\r\n",
        "WHERE f.latitud IS NOT NULL AND f.longitud IS NOT NULL;"
      ],
      "catalog": "proyecto_final",
      "schema": "gold"
    },
    {
      "name": "a97213e5",
      "displayName": "KPI2",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    SUM(f.es_generador_trafico) AS cantidad_atraccion\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "WHERE f.es_generador_trafico = 1\r\n",
        "GROUP BY b.barrio_nombre\r\n",
        "ORDER BY cantidad_atraccion DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "9c13fda1",
      "displayName": "KPI3",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    SUM(f.es_competencia) AS total_kioscos,\r\n",
        "    SUM(f.es_generador_trafico) AS total_atraccion,\r\n",
        "    --calculo de nivel de saturacion \r\n",
        "    ROUND(SUM(f.es_competencia) / COALESCE(NULLIF(SUM(f.es_generador_trafico), 0), 1), 2) AS nivel_saturacion\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "GROUP BY b.barrio_nombre\r\n",
        "HAVING SUM(f.es_competencia) > 10\r\n",
        "ORDER BY nivel_saturacion DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "0decf908",
      "displayName": "KPI1",
      "queryLines": [
        "\r\n",
        "WITH top_barrios_indice AS (\r\n",
        "    -- indice de oportunidad\r\n",
        "    SELECT \r\n",
        "        b.id AS barrio_id,\r\n",
        "        INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "        ROUND(SUM(f.es_generador_trafico) / COALESCE(NULLIF(SUM(f.es_competencia), 0), 1), 2) AS indice_oportunidad\r\n",
        "    FROM proyecto_final.gold.fact_entidades f\r\n",
        "    JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "    GROUP BY b.id, b.barrio_nombre\r\n",
        "    HAVING SUM(f.es_generador_trafico) > 10\r\n",
        "    ORDER BY indice_oportunidad DESC\r\n",
        "    LIMIT 10\r\n",
        ")\r\n",
        "-- detalle de entidades SOLO para esos barrios ganadores\r\n",
        "SELECT \r\n",
        "    tb.barrio_nombre,\r\n",
        "    tb.indice_oportunidad,\r\n",
        "    INITCAP(c.tipo_entidad) AS tipo_entidad,\r\n",
        "    COUNT(f.entidad_id) AS cantidad_entidades\r\n",
        "FROM top_barrios_indice tb\r\n",
        "JOIN proyecto_final.gold.fact_entidades f ON tb.barrio_id = f.barrio_id\r\n",
        "JOIN proyecto_final.gold.dim_categoria c ON f.categoria_id = c.id\r\n",
        "WHERE f.es_generador_trafico = 1 -- desglosamos la demanda, no los kioscos\r\n",
        "GROUP BY \r\n",
        "    tb.barrio_nombre, \r\n",
        "    tb.indice_oportunidad, \r\n",
        "    c.tipo_entidad\r\n",
        "ORDER BY \r\n",
        "    tb.indice_oportunidad DESC, \r\n",
        "    cantidad_entidades DESC;"
      ]
    },
    {
      "name": "507b3db7",
      "displayName": "Totales",
      "queryLines": [
        "\r\n",
        "SELECT \r\n",
        "    -- 1. Total absoluto de puntos analizados\r\n",
        "    COUNT(entidad_id) AS total_puntos_relevados,\r\n",
        "    \r\n",
        "    -- 2. Total de Atracción (La demanda potencial)\r\n",
        "    SUM(es_generador_trafico) AS total_demanda,\r\n",
        "    \r\n",
        "    -- 3. Total de Competencia (Los kioscos)\r\n",
        "    SUM(es_competencia) AS total_competencia,\r\n",
        "    \r\n",
        "    -- 4. Índice Promedio de Oportunidad de toda la ciudad\r\n",
        "    ROUND(SUM(es_generador_trafico) / COALESCE(NULLIF(SUM(es_competencia), 0), 1), 2) AS indice_promedio_caba\r\n",
        "\r\n",
        "FROM proyecto_final.gold.fact_entidades;"
      ]
    },
    {
      "name": "d1044b23",
      "displayName": "Calculos por barrio",
      "queryLines": [
        "\r\n",
        "WITH metricas_por_barrio AS (\r\n",
        "    -- 1. Calculamos los índices agrupados por ID de barrio\r\n",
        "    SELECT \r\n",
        "        barrio_id,\r\n",
        "        ROUND(SUM(es_generador_trafico) / COALESCE(NULLIF(SUM(es_competencia), 0), 1), 2) AS indice_oportunidad\r\n",
        "    FROM proyecto_final.gold.fact_entidades\r\n",
        "    GROUP BY barrio_id\r\n",
        "    ORDER BY indice_oportunidad desc\r\n",
        "    LIMIT 10\r\n",
        "), \r\n",
        "barrios_saturados AS (SELECT \r\n",
        "    b.id,\r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    SUM(f.es_competencia) AS total_kioscos,\r\n",
        "    SUM(f.es_generador_trafico) AS total_atraccion,\r\n",
        "    --calculo de nivel de saturacion \r\n",
        "    ROUND(SUM(f.es_competencia) / COALESCE(NULLIF(SUM(f.es_generador_trafico), 0), 1), 2) AS nivel_saturacion\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "GROUP BY b.id,b.barrio_nombre\r\n",
        "HAVING SUM(f.es_competencia) > 10\r\n",
        "ORDER BY nivel_saturacion DESC\r\n",
        "LIMIT 10),\r\n",
        "mejores_barrios as (SELECT \r\n",
        "    b.id,\r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    SUM(f.es_generador_trafico) AS cantidad_atraccion\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "WHERE f.es_generador_trafico = 1\r\n",
        "GROUP BY b.id,b.barrio_nombre\r\n",
        "ORDER BY cantidad_atraccion DESC\r\n",
        "LIMIT 10)\r\n",
        "\r\n",
        "SELECT \r\n",
        "    f.entidad_id,\r\n",
        "    INITCAP(b.barrio_nombre) AS barrio_nombre,\r\n",
        "    INITCAP(c.tipo_entidad) AS tipo_entidad,\r\n",
        "    \r\n",
        "\r\n",
        "    CASE \r\n",
        "        WHEN f.es_competencia = 1 THEN 'Competencia'\r\n",
        "        WHEN f.es_generador_trafico = 1 THEN 'Atracción'\r\n",
        "        ELSE 'Otro'\r\n",
        "    END AS clasificacion_comercial,\r\n",
        "    \r\n",
        "    f.latitud,\r\n",
        "    f.longitud,\r\n",
        "    f.es_generador_trafico,\r\n",
        "    f.es_competencia,\r\n",
        "    \r\n",
        "\r\n",
        "    mb.indice_oportunidad,\r\n",
        "    mb2.cantidad_atraccion,\r\n",
        "    bs.nivel_saturacion\r\n",
        "\r\n",
        "FROM proyecto_final.gold.fact_entidades f\r\n",
        "LEFT JOIN proyecto_final.gold.dim_barrios b ON f.barrio_id = b.id\r\n",
        "LEFT JOIN proyecto_final.gold.dim_categoria c ON f.categoria_id = c.id\r\n",
        "LEFT JOIN metricas_por_barrio mb ON f.barrio_id = mb.barrio_id\r\n",
        "LEFT JOIN mejores_barrios mb2 ON f.barrio_id = mb2.id\r\n",
        "LEFT JOIN barrios_saturados bs ON f.barrio_id = bs.id\r\n",
        "\r\n",
        "ORDER BY \r\n",
        "    mb.indice_oportunidad DESC, \r\n",
        "    clasificacion_comercial ASC;"
      ],
      "catalog": "proyecto_final",
      "schema": "gold"
    }
  ],
